  m_Name: 
  m_EditorClassIdentifier: RemixTable.Runtime::RemixTable.RemixMainMenu
  manager: {fileID: 1747873704}
  alsoHide:
  - {fileID: 2005695608}
  group: {fileID: 126476416}
  welcomePage: {fileID: 959001519}
  songsPage: {fileID: 1399278116}
  howToPage: {fileID: 1382521510}
  greeting: {fileID: 2019043250}
  nowLoaded: {fileID: 1792575168}
  howToTitle: {fileID: 512429906}
  howToBody: {fileID: 1454080712}
  howToPageLabel: {fileID: 1142005566}
  playButton: {fileID: 1205019956}
  songsButton: {fileID: 1756478323}
  howToButton: {fileID: 413683735}
  songsBackButton: {fileID: 1034635332}
  howToBackButton: {fileID: 144749971}
  howToPrevButton: {fileID: 1864452085}
  howToNextButton: {fileID: 1282325436}
  menuButton: {fileID: 384666532}
  songList: {fileID: 654962259}
  songTemplate: {fileID: 1082611546}
  playGlow: {fileID: 257416728}
  continueButton: {fileID: 1645314367}
  continueDetail: {fileID: 307754754}
  background: {fileID: 187198353}
  howToPages:
  - title: WELCOME TO REMIX TABLE
    body: 'Every song is split into four glowing ribbons, one per stem:

      VOCALS,
      DRUMS, BASS and OTHER (top to bottom).

      The wave you see is the sound
      you hear.'
  - title: PINCH TO SCULPT
    body: 'Reach out and pinch a ribbon.

      Move your hand UP to make that part
      louder, DOWN to make it quieter.

      Let go and the change is saved into
      the song.'
  - title: VOLUME OR FILTER
    body: 'VOLUME / FILTER choose what a pinch edits.

      FILTER: up makes the
      stem brighter, down makes it darker and muffled.

      EDIT pauses while you
      shape; LIVE keeps the music playing.'
  - title: MIX LIKE A PRO
    body: 'M / S mute or solo a stem.  PITCH shifts it up or down.

      SNAP locks
      edits to the beat.  LOOP repeats a section.

      UNDO / REDO step through
      your edits.'
  - title: GO BIGGER
    body: 'SPATIAL puts each stem around you in 3D.

      ROOM shows your real room
      and places the table on your desk.

      VIBES, DAILY DROP and REC to save
      your remix as a WAV.'
  - title: COME BACK ANY TIME
    body: 'Press MENU above the ribbons to return here,

      pick another song
      or read this guide again.

      Now press PLAY and make it yours.'
